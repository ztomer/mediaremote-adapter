# gates_of_heck configuration. All keys optional; delete what you don't use.
# Full key reference: docs/config.md in the gates_of_heck checkout
# (or .gatesrc.example there for a commented starter with every key).
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='^vendor/|\.generated\.'  # not ours to re-style (never exempts the secrets scan)
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_PY_COV_MIN=95
GOH_SWIFT_MODE=spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25 etc. live OUTSIDE the gates since v0.8.0 — set them
# in the environment for the scripts repo's bin/disk_hygiene.sh, not here.
# Upstream-owned (ejbills/mediaremote-adapter): splitting it in the fork would turn every upstream
# merge of this file into a hand-merge. Remove when upstream splits it or the fork stops merging.
GOH_LINE_EXCLUDE='^Sources/CIMediaRemote/MediaRemoteAdapter\.m$'
# Shrink-only lint ratchet, seeded 2026-10-12 with the 29 violations present at install. Re-record
# (swiftlint lint --strict --write-baseline .swiftlint-baseline.json) only to SHRINK it.
GOH_SWIFT_LINT_BASELINE=.swiftlint-baseline.json
# The exemption above is not an exemption from every bound: its ceiling is its size today.
GOH_LINE_BASELINE=.line-baseline
# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule; a count of 1 floors at 1);
# lower one with the tree in the same commit, never to absorb a scan that went
# blind.
GOH_EMOJI_MIN_FILES=28                # read 32
GOH_CONFLICT_MARKERS_MIN_FILES=28     # read 32
GOH_FILE_LENGTH_MIN_FILES=9           # read 11
GOH_SECRETS_MIN_FILES=28              # read 32
GOH_SHELL_LINT_MIN_FILES=1            # read 1
GOH_EARLY_EXIT_PIPE_MIN_FILES=5       # read 6
GOH_DEAD_AFTER_EXEC_MIN_FILES=5       # read 6
GOH_BARE_HOOK_INDEX_MIN_FILES=5       # read 6
GOH_BARE_PYTHON_MIN_FILES=5           # read 6
GOH_MD_LINKS_MIN_LINKS=1              # read 1
